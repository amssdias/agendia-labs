# Build-time settings. Override per machine in .env.local (git-ignored) or per mode in .env.production.

# Public URL of the site root, no trailing slash. Used for canonical, hreflang, og:url and sitemap.xml.
# A path is allowed and becomes the base path, e.g. https://user.github.io/dias-flow for a GitHub project page.
SITE_URL=https://diasflow.com

# "#contact" scrolls to the contact form. Any other URL (e.g. a Cal.com link) opens in a new tab.
SITE_BOOKING_URL=#contact

# URL that receives the contact form as JSON (e.g. an n8n webhook).
# Left empty, the form opens a pre-filled email to hello@diasflow.com instead.
SITE_FORM_ENDPOINT=
