# Build-time settings. Override per machine in .env.local (git-ignored) or per mode in .env.production.

# Public URL of the site root, no trailing slash. Used for canonical, hreflang, og:url and sitemap.xml.
# A path is allowed and becomes the base path, e.g. https://user.github.io/agendia-labs for a GitHub project page.
SITE_URL=https://agendialabs.com

# URL that receives the contact form as JSON (e.g. a Formspree form: https://formspree.io/f/<id>).
# Left empty, the form opens a pre-filled email to agendialabs@gmail.com instead.
SITE_FORM_ENDPOINT=https://formspree.io/f/xrpqoolw
